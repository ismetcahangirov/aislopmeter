{
  "name": "aislopmeter",
  "version": "0.1.0",
  "description": "Measure the AI slop on any website, then fix it. Scan a URL or a web project for generic copy, template design and unfinished details, then let your own AI rescue it. CLI + MCP server.",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/aislopmeter.js mcp"
  },
  "keywords": [
    "ai-slop",
    "slop",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "vibe-coding",
    "copywriting",
    "web-design",
    "seo",
    "lint",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "linkedom": "^0.18.13",
    "zod": "^4.6.7"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "aislopmeter": "bin/aislopmeter.js"
  },
  "files": [
    "bin",
    "src",
    "docs/CRITERIA.md",
    "playbook",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "playwright-core": "^1.60.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omergocmen/aislopmeter.git"
  },
  "homepage": "https://github.com/omergocmen/aislopmeter#readme",
  "bugs": {
    "url": "https://github.com/omergocmen/aislopmeter/issues"
  }
}
