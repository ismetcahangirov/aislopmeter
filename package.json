{
  "name": "aislopmeter",
  "version": "0.3.1",
  "description": "Measure the AI slop on any website, then fix it. Scans a whole site, a local app or a project folder for generic copy, template design and unfinished details, and gives step-by-step fixes your own AI can apply. MCP server + CLI.",
