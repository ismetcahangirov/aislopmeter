    "lint",
    "lovable",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "seo",
    "shadcn",
    "slop",
    "tailwind",
    "turkish",
    "v0",
    "vibe-coding",
    "web-design",
    "website-audit"
  ],
  "homepage": "https://aislopmeter.netlify.app",
  "bugs": {
    "url": "https://github.com/omergocmen/aislopmeter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omergocmen/aislopmeter.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ömer Göçmen",
    "url": "https://github.com/omergocmen"
  },
  "type": "module",
